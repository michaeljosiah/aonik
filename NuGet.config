<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet feed configuration for AONIK.

  Voxa.* packages are published to the michaeljosiah/voxa GitHub Packages NuGet feed
  (see Voxa repo .github/workflows/publish-packages.yml). Everything else comes from
  nuget.org. The packageSourceMapping below pins Voxa.* to the github source so the
  restore is deterministic and fast.

  Authentication:
  - CI: GITHUB_TOKEN env var is provided by the workflow (with packages:read permission).
  - Local dev: set GITHUB_TOKEN to a personal access token with `read:packages` scope
    (any account that can read the public Voxa repo will do, since GitHub Packages
    NuGet requires auth even for public packages).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/michaeljosiah/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="aonik-ci" />
      <!-- NuGet substitutes %ENV_VAR% from the environment at restore time. -->
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Voxa.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
