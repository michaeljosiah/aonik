<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Voice</RootNamespace>
  </PropertyGroup>

  <!--
    Boundary enforcement: only Api, Infrastructure, and test projects may
    access internals. Mirrors the convention used by Aonik.Agents.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Infrastructure" />
    <InternalsVisibleTo Include="Aonik.Voice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
    <!--
      Aonik.Voice depends on Aonik.Agents for IAgentContextualizer,
      IChatThreadManager, IPostStreamPersistenceCoordinator, AguiRunOptionsBuilder,
      IAguiMessageConverter, AguiMessage, ToolCallClassifier. The voice adapter
      mirrors AGUI's stateless re-run pattern so reuses these contracts directly.
    -->
    <ProjectReference Include="..\Aonik.Agents\Aonik.Agents.csproj" />
    <!--
      Aonik.Voice depends on Aonik.Ai for ISpeechTextNormalizer (Phase 2 abstraction)
      and AiTelemetry constants (UseCaseAttribute, ActivitySource).
    -->
    <ProjectReference Include="..\Aonik.Ai\Aonik.Ai.csproj" />

  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Voxa packages — published from michaeljosiah/voxa to GitHub Packages on every push to main
      (see Voxa repo .github/workflows/publish-packages.yml). The NuGet.config at the AONIK repo
      root pins Voxa.* to the github source via packageSourceMapping; restore needs GITHUB_TOKEN
      with packages:read scope.

      The voice agent loop is delegated to Voxa.Services.MicrosoftAgents.MicrosoftAgentVoice
      .CreateProcessor; AONIK injects history / preamble / run-options / frontend-tool /
      backend-tool-status semantics through closure-configured MicrosoftAgentVoiceOptions
      delegates (see Processors/AonikVoiceAgent.cs).

      Bump these versions when picking up new Voxa work; the publish workflow uses
      0.1.0-alpha.{run_number} so each main push gets a fresh version.
    -->
    <PackageReference Include="Voxa.Core" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.AspNetCore" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Transports.WebSocket" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Speech.Abstractions" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Services.MicrosoftAgents" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Speech.OpenAI" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Speech.Azure" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Speech.ElevenLabs" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Speech.Mistral" Version="0.1.0-alpha.1" />
    <PackageReference Include="Voxa.Audio.SileroVad" Version="0.1.0-alpha.1" />

    <!--
      MAF aligned with Voxa at 1.5.0.
    -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.5.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.1" />
  </ItemGroup>

</Project>
