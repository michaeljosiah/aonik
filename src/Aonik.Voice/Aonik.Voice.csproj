<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Voice</RootNamespace>
  </PropertyGroup>

  <!--
    Boundary enforcement: only Api, Infrastructure, and test projects may
    access internals. Mirrors the convention used by Aonik.Agents.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Infrastructure" />
    <InternalsVisibleTo Include="Aonik.Voice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
    <!--
      Aonik.Voice depends on Aonik.Agents for IAgentContextualizer,
      IChatThreadManager, IPostStreamPersistenceCoordinator, AguiRunOptionsBuilder,
      IAguiMessageConverter, AguiMessage, ToolCallClassifier. The voice adapter
      mirrors AGUI's stateless re-run pattern so reuses these contracts directly.
    -->
    <ProjectReference Include="..\Aonik.Agents\Aonik.Agents.csproj" />
    <!--
      Aonik.Voice depends on Aonik.Ai for ISpeechTextNormalizer (Phase 2 abstraction)
      and AiTelemetry constants (UseCaseAttribute, ActivitySource).
    -->
    <ProjectReference Include="..\Aonik.Ai\Aonik.Ai.csproj" />

  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Voxa packages — public on nuget.org. Published from michaeljosiah/voxa via
      .github/workflows/release.yml on tag push (vX.Y.Z-alpha → 14 nupkgs).

      The voice agent loop is delegated to Voxa.Services.MicrosoftAgents.MicrosoftAgentVoice
      .CreateProcessor; AONIK injects history / preamble / run-options / frontend-tool /
      backend-tool-status semantics through closure-configured MicrosoftAgentVoiceOptions
      delegates (see Processors/AonikVoiceAgent.cs).

      Bump every Voxa.* version together when picking up new Voxa work — they're all packed
      from the same tagged commit, so mixing versions can cause type-load failures.
    -->
    <PackageReference Include="Voxa.Core" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.AspNetCore" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Transports.WebSocket" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Speech.Abstractions" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Services.MicrosoftAgents" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Speech.OpenAI" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Speech.Azure" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Speech.ElevenLabs" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Speech.Mistral" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Audio.SileroVad" Version="0.4.0-alpha" />
    <!--
      Composite voice (Phase H follow-up). One bidirectional processor each for OpenAI's
      Realtime API and Azure Voice Live, both folding STT+LLM+TTS+VAD+turn-taking into a
      single WSS session. Pulled in by AonikVoicePipelineFactory.BuildComposite.
    -->
    <PackageReference Include="Voxa.Services.OpenAIRealtime" Version="0.4.0-alpha" />
    <PackageReference Include="Voxa.Services.AzureVoiceLive" Version="0.4.0-alpha" />

    <!--
      MAF aligned with Voxa at 1.5.0.
    -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />

    <!--
      EF Core (spec 024 Phase A — speech provider library). VoiceDbContext is module-scoped per
      AONIK convention; migrations still ship via the canonical AonikDbContext.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
  </ItemGroup>

</Project>
