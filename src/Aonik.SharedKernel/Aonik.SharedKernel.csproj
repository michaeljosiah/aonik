<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    AspNetCore framework reference + FastEndpoints package so SharedKernel
    can host cross-cutting endpoint helpers (Authorization/RequirePermission)
    that domain modules reuse without a back-pointing dependency on Agents.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />
    <!--
      Bumped to 10.0.4 to match the transitive minimum demanded by
      Microsoft.Extensions.AI 10.4.1 (which Microsoft.Agents.AI rc4 brings in).
      Without these, SharedKernel produces NU1605 (package downgrade detected)
      when consumers resolve the graph.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
    <!--
      The agent contributor contract (Abstractions.Agents.IDomainAgentDescriptor)
      returns Microsoft.Agents.AI.AIAgent and accepts a Microsoft.Extensions.AI
      IChatClient — so SharedKernel MUST reference both packages to host the
      contract. Domain modules contribute their agents through this surface
      without taking a back-pointing reference on Aonik.Agents.
    -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-rc4" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.1" />
  </ItemGroup>

</Project>
