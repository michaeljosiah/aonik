<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    AspNetCore framework reference + FastEndpoints package so SharedKernel
    can host cross-cutting endpoint helpers (Authorization/RequirePermission)
    that domain modules reuse without a back-pointing dependency on Agents.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Spec 096 §16. ContentDeliveryPermit's constructor is internal so that NOTHING outside the safety
    module can manufacture one: a delivery path takes a permit rather than a boolean, which turns
    "did you remember to check?" from a convention into a compile-time requirement. Aonik.Ai holds
    the gate that issues them; the test assemblies assert that the boundary holds.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Ai" />
    <InternalsVisibleTo Include="Aonik.Application.Tests" />
    <InternalsVisibleTo Include="Aonik.Architecture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <PackageReference Include="FluentValidation" Version="12.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <!--
      Relational (provider-agnostic, not a specific provider like SqlServer) so the
      outbox/inbox IEntityTypeConfigurations can map their relational table/index
      names. These tables carry a uniform "Ank" prefix in every DbContext, so the
      mapping is defined once here and applied to all contexts via
      AonikDbContextBase.OnModelCreating, keeping module write paths consistent.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />
    <!--
      Bumped to 10.0.8 to match the transitive minimum demanded by
      Microsoft.Extensions.AI 10.6.0 (which Microsoft.Agents.AI 1.9.0 brings in).
      Without these, SharedKernel produces NU1605 (package downgrade detected)
      when consumers resolve the graph.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <!--
      The agent contributor contract (Abstractions.Agents.IDomainAgentDescriptor)
      returns Microsoft.Agents.AI.AIAgent and accepts a Microsoft.Extensions.AI
      IChatClient — so SharedKernel MUST reference both packages to host the
      contract. Domain modules contribute their agents through this surface
      without taking a back-pointing reference on Aonik.Agents.
    -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
  </ItemGroup>

  <!--
    Deterministic demo-seed ids (Spec 027 S5, #118/#126). Relocated from
    Aonik.Finance so the Finance seed contributor and the PersonalFinance seed
    phases can both load them via FinanceDemoSeedIds without a cross-module
    reference. The manifest-resource name embeds this assembly name +
    "Seeding.Data", matched in FinanceDemoSeedIds.ResourceName.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Seeding\Data\*.json" />
    <!-- Spec 065 — business-type config-pack manifests, read by ConfigPackSource (here) so any module + the CLI can load them. -->
    <EmbeddedResource Include="Abstractions\Packs\Data\*.pack.json" />
  </ItemGroup>

</Project>
