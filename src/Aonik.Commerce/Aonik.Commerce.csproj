<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Commerce</RootNamespace>
  </PropertyGroup>

  <!--
    Spec 042 — Aonik.Commerce is a first-class B2C retail module. It owns the genuinely new
    retail domain (catalog, product pricing, inventory, cart/checkout, composite/BYO bundles) and
    REUSES the platform foundations a product purchase already has. Per ADR-005 / ADR-011 it
    references ONLY SharedKernel + Aonik.Ordering (the middle-layer Order spine) — never
    Aonik.Finance. Orders flow through SharedKernel.Abstractions.Ordering.IOrderService; billing
    and payment go through SharedKernel write contracts implemented by Finance. No module holds a
    ProjectReference TO Aonik.Commerce except Aonik.Infrastructure (canonical migration stream).
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Infrastructure" />
    <InternalsVisibleTo Include="Aonik.Worker" />
    <InternalsVisibleTo Include="Aonik.Migrator" />
    <InternalsVisibleTo Include="Aonik.Commerce.Tests" />
    <InternalsVisibleTo Include="Aonik.Application.Tests" />
    <InternalsVisibleTo Include="Aonik.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
    <ProjectReference Include="..\Aonik.Ordering\Aonik.Ordering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
  </ItemGroup>

</Project>
