{
  "UseInMemoryDatabase": true,
  "InMemoryDatabaseName": "AonikTestDb",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Communication": {
    "Azure": {
      "ConnectionString": "",
      "Email": {
        "FromAddress": ""
      },
      "Sms": {
        "FromPhoneNumber": ""
      }
    }
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 5,
