{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AonikDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AI": {
    "PromptTemplatesPath": null
  },
  "Auth": {
    "TenantRouting": "Header"
  },
  "Settings": {
    "Auth.Provider": "AzureAd",
    "Auth.Auth0.Domain": "{domain}.eu.auth0.com",
    "Auth.Auth0.Audience": "{api-identifier}",
    "Auth.Auth0.ClientId": "{client-id}",
    "Auth.Auth0.Connection": "Username-Password-Authentication",
    "Auth.Auth0.ManagementAudience": "https://{domain}.eu.auth0.com/api/v2/",
    "Auth.AzureAd.Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
    "Auth.AzureAd.Audience": "api://{client-id}",
    "Auth.AzureAd.ClientId": "{client-id}",
    "Auth.AzureAd.TenantId": "{tenant-id}",
    "Auth.AzureAd.UserPrincipalNameDomain": "{your-upn-domain}"
  },
  "Bootstrap": {
    "Enabled": true,
    "TenantName": "Aonik Dev Tenant",
    "Environment": "Development",
    "DefaultCurrency": "USD",
    "SupportedCountries": [
      "US"
    ]
  },
  "Communication": {
    "Azure": {
      "ConnectionString": "",
      "Email": {
        "FromAddress": ""
      },
      "Sms": {
        "FromPhoneNumber": ""
      }
    }
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 10,
    "MaxAttempts": 5,
    "HashKey": "dev-change-me",
    "RateLimits": {
      "WindowMinutes": 15,
      "MaxPerUserChannel": 5,
      "MaxPerTargetChannel": 10
    }
  },
  "Swagger": {
    "ClientId": "swagger-dev-client",
    "Scopes": [
      "openid",
      "profile",
      "email"
    ],
    "RedirectUri": "https://localhost:5001/swagger/oauth2-redirect.html"
  },
  "Database": {
    "AutoMigrate": true
  }
}
