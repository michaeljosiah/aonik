{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AonikDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AI": {
    "PromptTemplatesPath": null
  },
  "Auth": {
    "TenantRouting": "Header"
  },
  "Swagger": {
    "ClientId": "swagger-dev-client",
    "Scopes": [
      "openid",
      "profile",
      "email"
    ],
    "RedirectUri": "https://localhost:5001/swagger/oauth2-redirect.html"
  }
}

