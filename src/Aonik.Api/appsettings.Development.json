{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AonikDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AI": {
    "PromptTemplatesPath": null
  },
  "Auth": {
    "TenantRouting": "Header"
  },
  "Bootstrap": {
    "Enabled": true,
    "TenantName": "Aonik Dev Tenant",
    "Environment": "Development",
    "DefaultCurrency": "USD",
    "SupportedCountries": [
      "US"
    ]
  },
  "Communication": {
    "Azure": {
      "ConnectionString": "",
      "Email": {
        "FromAddress": ""
      },
      "Sms": {
        "FromPhoneNumber": ""
      }
    }
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 10,
    "MaxAttempts": 5,
    "HashKey": "dev-change-me",
    "RateLimits": {
      "WindowMinutes": 15,
      "MaxPerUserChannel": 5,
      "MaxPerTargetChannel": 10
    }
  },
  "Swagger": {
    "ClientId": "swagger-dev-client",
    "Scopes": [
      "openid",
      "profile",
      "email"
    ],
    "RedirectUri": "https://localhost:5001/swagger/oauth2-redirect.html"
  }
}
