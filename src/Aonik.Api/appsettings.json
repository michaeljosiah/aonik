{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Provider": "Auth0",
    "TenantRouting": "Header",
    "Auth0": {
      "Authority": "https://aonik.uk.auth0.com/",
      "Audience": "https://api.aonik.com",
      "ValidateIssuer": true,
      "ClockSkewSeconds": 300
    }
  },
  "Settings": {
    "Auth.Provider": "Auth0",
    "Auth.Auth0.Domain": "aonik.uk.auth0.com",
    "Auth.Auth0.Audience": "https://api.aonik.com",
    "Auth.Auth0.ClientId": "",
    "Auth.Auth0.ManagementClientId": "",
    "Auth.Auth0.ManagementClientSecret": "",
    "Auth.Auth0.Connection": "Username-Password-Authentication",
    "Auth.Auth0.ManagementAudience": "https://aonik.uk.auth0.com/api/v2/",
    "Auth.AzureAd.Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
    "Auth.AzureAd.Audience": "api://{client-id}",
    "Auth.AzureAd.ClientId": "{client-id}",
    "Auth.AzureAd.TenantId": "{tenant-id}",
    "Auth.AzureAd.UserPrincipalNameDomain": "{your-upn-domain}"
  },
  "PlatformAdmin": {
    "RoleClaimType": "roles",
    "RoleValue": "Aonik.PlatformAdmin",
    "ScopeClaimType": "aonik_platform_admin",
    "AdminEmails": ["michael.josiah@mailinator.com"]
  },
  "Bootstrap": {
    "Enabled": false,
    "SetupSecret": "",
    "TenantName": "Aonik Dev Tenant",
    "Environment": "Development",
    "DefaultCurrency": "USD",
    "SupportedCountries": [
      "US"
    ]
  },
  "Communication": {
    "Azure": {
      "ConnectionString": "",
      "Email": {
        "FromAddress": ""
      },
      "Sms": {
        "FromPhoneNumber": ""
      }
    }
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 10,
    "MaxAttempts": 5,
    "HashKey": "",
    "RateLimits": {
      "WindowMinutes": 15,
      "MaxPerUserChannel": 5,
      "MaxPerTargetChannel": 10
    }
  },
  "BlobStorage": {
    "Provider": "Local",
    "LocalBasePath": "App_Data",
    "Azure": {
      "AccountName": "",
      "AccountKey": ""
    },
    "ProfilePhotos": {
      "Path": "profiles",
      "ContainerName": "profiles",
      "PublicBaseUrl": ""
    },
    "ProductImages": {
      "Path": "products",
      "ContainerName": "products",
      "PublicBaseUrl": ""
    },
    "Documents": {
      "Path": "documents",
      "ContainerName": "documents",
      "PublicBaseUrl": ""
    }
  },
  "Swagger": {
    "ClientId": "{swagger-client-id}",
    "Scopes": [
      "api://{client-id}/access_as_user"
    ]
  },
  "AI": {
    "Provider": "Stub",
    "OpenTelemetry": {
      "EnableSensitiveData": false
    },
    "TextToSpeech": {
      "ElevenLabsBaseUrl": "https://api.elevenlabs.io",
      "ElevenLabsApiKey": ""
    }
  },
  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "ApiKey": "qdrant-dev-key",
    "CollectionPrefix": "aonik-dev",
    "VectorDimensions": 1536,
    "EmbeddingModel": "text-embedding-3-small",
    "Timeout": 30,
    "EnableTelemetry": true
  },
  "Runtime": {
    "AzureContainerApps": {
      "Enabled": false,
      "EnvironmentName": "",
      "SubscriptionId": "",
      "ResourceGroupName": "",
      "WorkloadName": "aonik",
      "ManagementBaseUrl": "https://management.azure.com/"
    }
  },
  "FeatureManagement": {
    "BillPayments.Invoicing.Create": true,
    "BillPayments.Invoicing.Issue": true,
    "BillPayments.Invoicing.Payment": true,
    "BillPayments.Invoicing.Discounts": false,
    "BillPayments.Invoicing.Allocations": true,
    "BillPayments.CustomerAccounts.Management": true
  },
  "Finance": {
    "PersonalFinance": {
      "LinkedAccountSync": {
        "EnableRecurringSync": true,
        "DefaultSyncIntervalMinutes": 360,
        "WorkerPollIntervalSeconds": 60,
        "BatchSize": 25,
        "FailureRetryDelayMinutes": 15
      },
      "Plaid": {
        "UseRealPlaidApi": false,
        "BaseUrl": "https://sandbox.plaid.com",
        "ClientId": "",
        "Secret": "",
        "ClientName": "Payabo",
        "Language": "en",
        "Products": [
          "transactions"
        ],
        "CountryCodes": [
          "US"
        ],
        "WebhookUrl": ""
      }
    }
  }
}
