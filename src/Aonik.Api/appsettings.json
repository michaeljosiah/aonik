{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Provider": "AzureAd",
    "TenantRouting": "Claim",
    "AzureAd": {
      "Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
      "Audience": "api://{client-id}",
      "ValidateIssuer": true,
      "ClockSkewSeconds": 300
    },
    "Auth0": {
      "Authority": "https://{domain}.eu.auth0.com/",
      "Audience": "{api-identifier}",
      "ValidateIssuer": true,
      "ClockSkewSeconds": 300
    }
  },
  "Settings": {
    "Auth.Provider": "AzureAd",
    "Auth.Auth0.Domain": "{domain}.eu.auth0.com",
    "Auth.Auth0.Audience": "{api-identifier}",
    "Auth.Auth0.ClientId": "{client-id}",
    "Auth.Auth0.Connection": "Username-Password-Authentication",
    "Auth.Auth0.ManagementAudience": "https://{domain}.eu.auth0.com/api/v2/",
    "Auth.AzureAd.Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
    "Auth.AzureAd.Audience": "api://{client-id}",
    "Auth.AzureAd.ClientId": "{client-id}",
    "Auth.AzureAd.TenantId": "{tenant-id}",
    "Auth.AzureAd.UserPrincipalNameDomain": "{your-upn-domain}"
  },
  "PlatformAdmin": {
    "RoleClaimType": "roles",
    "RoleValue": "Aonik.PlatformAdmin",
    "ScopeClaimType": "aonik_platform_admin",
    "AdminEmails": ["michael.josiah@mailinator.com"]
  },
  "Bootstrap": {
    "Enabled": false,
    "TenantName": "Aonik Dev Tenant",
    "Environment": "Development",
    "DefaultCurrency": "USD",
    "SupportedCountries": [
      "US"
    ]
  },
  "Communication": {
    "Azure": {
      "ConnectionString": "",
      "Email": {
        "FromAddress": ""
      },
      "Sms": {
        "FromPhoneNumber": ""
      }
    }
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 10,
    "MaxAttempts": 5,
    "HashKey": "",
    "RateLimits": {
      "WindowMinutes": 15,
      "MaxPerUserChannel": 5,
      "MaxPerTargetChannel": 10
    }
  },
  "Swagger": {
    "ClientId": "{swagger-client-id}",
    "Scopes": [
      "api://{client-id}/access_as_user"
    ],
    "RedirectUri": "/swagger/oauth2-redirect.html"
  }
}
