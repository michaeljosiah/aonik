{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Provider": "AzureAd",
    "TenantRouting": "Claim",
    "AzureAd": {
      "Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
      "Audience": "api://{client-id}",
      "ValidateIssuer": true,
      "ClockSkewSeconds": 300
    },
    "Auth0": {
      "Authority": "https://{domain}.eu.auth0.com/",
      "Audience": "{api-identifier}",
      "ValidateIssuer": true,
      "ClockSkewSeconds": 300
    }
  },
  "PlatformAdmin": {
    "RoleClaimType": "roles",
    "RoleValue": "Aonik.PlatformAdmin",
    "ScopeClaimType": "aonik_platform_admin"
  },
  "Bootstrap": {
    "Enabled": false,
    "TenantName": "Aonik Dev Tenant",
    "Environment": "Development",
    "DefaultCurrency": "USD",
    "SupportedCountries": [
      "US"
    ]
  },
  "Communication": {
    "Azure": {
      "ConnectionString": "",
      "Email": {
        "FromAddress": ""
      },
      "Sms": {
        "FromPhoneNumber": ""
      }
    }
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 10,
    "MaxAttempts": 5,
    "HashKey": "",
    "RateLimits": {
      "WindowMinutes": 15,
      "MaxPerUserChannel": 5,
      "MaxPerTargetChannel": 10
    }
  },
  "Swagger": {
    "ClientId": "{swagger-client-id}",
    "Scopes": [
      "api://{client-id}/access_as_user"
    ],
    "RedirectUri": "/swagger/oauth2-redirect.html"
  }
}
