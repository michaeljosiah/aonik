{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Quartz": {
    "Persistence": {
      "Enabled": true,
      "TablePrefix": "QRTZ_",
      "SchedulerName": "AonikScheduler",
      "MisfireThresholdSeconds": 60,
      "Clustered": true,
      "ClusterCheckinIntervalSeconds": 15
    },
    "ScheduledJobs": {
      "FinancialConnectionSync": {
        "Enabled": true,
        "CronExpression": "0 * * * * ?",
        "BatchSize": 25
      },
      "StaleSessionDetector": {
        "Enabled": true,
        "CronExpression": "0 0/5 * * * ?",
        "BatchSize": 10,
        "AgentNames": [ "personal-finance-agent" ]
      },
      "AiCostGuard": {
        "Enabled": true,
        "CronExpression": "0 0/15 * * * ?",
        "TimeRange": "1h",
        "ThresholdUsd": 5.0
      }
    }
  }
}
