<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Finance</RootNamespace>
  </PropertyGroup>

  <!-- Boundary enforcement: only Api, Platform, and test projects may access internals -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Infrastructure" />
    <InternalsVisibleTo Include="Aonik.Platform" />
    <InternalsVisibleTo Include="Aonik.Worker" />
    <InternalsVisibleTo Include="Aonik.Migrator" />
    <InternalsVisibleTo Include="Aonik.Finance.Tests" />
    <InternalsVisibleTo Include="Aonik.Application.Tests" />
    <InternalsVisibleTo Include="Aonik.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Aonik.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.1" />
  </ItemGroup>

  <!--
    Spec 025 Phase 1 — Hyperlight sandbox for CodeAct-style sub-agent
    execution. Bundled Python WASM guest in `Guest.Python` solves the §11.5
    sourcing blocker; `Extensions.AI` ships a MAF-shaped CodeExecutionTool
    whose `.AsAIFunction()` drops into `ChatOptions.Tools`. The native
    runtime is Linux-only at v0.4.0 (Windows support in flight upstream),
    so each sub-agent descriptor's Build() picks the CodeAct path only when
    HyperlightHostAvailability.IsAvailable; Windows local dev falls back to
    the conventional tool-loop ChatClientAgent path.
  -->
  <ItemGroup>
    <PackageReference Include="Hyperlight.HyperlightSandbox.Api" Version="0.4.0" />
    <PackageReference Include="Hyperlight.HyperlightSandbox.Extensions.AI" Version="0.4.0" />
    <PackageReference Include="Hyperlight.HyperlightSandbox.Guest.Python" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\Seeding\Data\*.json" />
  </ItemGroup>

</Project>
