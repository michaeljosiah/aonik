<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Finance</RootNamespace>
    <!-- TODO(#119): ratchet opt-out — 26 pre-existing warnings (mostly banned
         IgnoreQueryFilters + nullability). Clear the backlog, then delete this
         line so the TreatWarningsAsErrors=true default (Directory.Build.props) applies. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Boundary enforcement: only Api, Platform, and test projects may access internals -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Infrastructure" />
    <InternalsVisibleTo Include="Aonik.Platform" />
    <InternalsVisibleTo Include="Aonik.Worker" />
    <InternalsVisibleTo Include="Aonik.Migrator" />
    <InternalsVisibleTo Include="Aonik.Finance.Tests" />
    <InternalsVisibleTo Include="Aonik.Finance.IntegrationTests" />
    <InternalsVisibleTo Include="Aonik.Application.Tests" />
    <InternalsVisibleTo Include="Aonik.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Aonik.Api.Tests" />
    <!-- Spec 088 §8: the filtered unique indexes can only be verified against a real engine. -->
    <InternalsVisibleTo Include="Aonik.Database.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
    <!-- Spec 041 / ADR-011: the Order spine lives in the Aonik.Ordering middle layer.
         Finance depends downward on it for the Order entities + the core IOrderService it
         composes for bill-payment / remittance creation. -->
    <ProjectReference Include="..\Aonik.Ordering\Aonik.Ordering.csproj" />
    <!--
      Spec 027 S5 (#118/#126): the transitional Finance -> PersonalFinance
      ProjectReference was DROPPED here. Every Finance-side call site that
      reached into PersonalFinance (agent tools, sub-agent registrations,
      CodeAct endpoint shims, seed contributors, the AccountLinking subtree,
      the PF DbSets) has been relocated. Finance and PersonalFinance are now
      true ADR-006 siblings; PersonalFinance reads Finance data only through
      the SharedKernel.Abstractions.Finance read contracts.
    -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
  </ItemGroup>

  <!-- Azure.Core / Azure.Identity / Hyperlight package refs relocated to
       Aonik.PersonalFinance.csproj with the CodeAct sandbox tree
       (Spec 027 Phase 5). -->


  <ItemGroup>
    <EmbeddedResource Include="Services\Seeding\Data\*.json" />
  </ItemGroup>

</Project>
