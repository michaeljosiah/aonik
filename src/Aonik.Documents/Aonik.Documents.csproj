<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Documents</RootNamespace>
  </PropertyGroup>

  <!--
    Spec 035 — Aonik.Documents is a first-class sibling module. Per the
    ADR-006 / Spec 027 precedent it references ONLY SharedKernel; the blob
    store and the scoped vector adapter are SharedKernel interfaces
    implemented in Aonik.Infrastructure and injected at the composition root.
    No module holds a ProjectReference TO Aonik.Documents; consumers use
    SharedKernel.Abstractions.Documents + integration events.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Infrastructure" />
    <InternalsVisibleTo Include="Aonik.Worker" />
    <InternalsVisibleTo Include="Aonik.Migrator" />
    <InternalsVisibleTo Include="Aonik.Documents.Tests" />
    <InternalsVisibleTo Include="Aonik.Application.Tests" />
    <InternalsVisibleTo Include="Aonik.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
  </ItemGroup>

</Project>
