<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Platform</RootNamespace>
    <!-- TODO(#119): ratchet opt-out — 16 pre-existing warnings (mostly banned
         IgnoreQueryFilters + nullability). Clear the backlog, then delete this
         line so the TreatWarningsAsErrors=true default (Directory.Build.props) applies. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Boundary enforcement: only Api, Worker, Migrator, and test projects may access internals -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Worker" />
    <InternalsVisibleTo Include="Aonik.Migrator" />
    <InternalsVisibleTo Include="Aonik.Platform.Tests" />
    <InternalsVisibleTo Include="Aonik.Application.Tests" />
    <InternalsVisibleTo Include="Aonik.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Aonik.Api.Tests" />
    <!-- Castle.DynamicProxy (used by Moq) needs to see internal interfaces
         to generate a runtime proxy. Without this, Mock<IInternalThing>
         throws "not accessible to the proxy generator". -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
    <ProjectReference Include="..\Aonik.Finance\Aonik.Finance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <!-- Quartz is used purely as a cron-expression evaluator (CronExpression) by the
         Task/WorkItem RecurrenceCalculator (Spec 034); the Quartz scheduler itself runs
         only in the Worker. Same version as the Worker/Infrastructure references. -->
    <PackageReference Include="Quartz" Version="3.14.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <!--
      Direct reference because Platform's tenant-settings caches use
      FusionCache. Previously transitive via Aonik.Agents; pulled in
      explicitly after Platform → Agents back-pointing was removed.
    -->
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Seed\Data\*.json" />
  </ItemGroup>

</Project>
