<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.Application\Aonik.Application.csproj" />
    <ProjectReference Include="..\Aonik.Infrastructure\Aonik.Infrastructure.csproj" />
    <ProjectReference Include="..\Aonik.Platform\Aonik.Platform.csproj" />
    <ProjectReference Include="..\Aonik.Finance\Aonik.Finance.csproj" />
    <ProjectReference Include="..\Aonik.Ai\Aonik.Ai.csproj" />
    <ProjectReference Include="..\Aonik.Agents\Aonik.Agents.csproj" />
  </ItemGroup>

</Project>
