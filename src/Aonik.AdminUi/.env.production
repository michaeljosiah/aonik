# Renderer build-time defaults used when `vite build` runs without a
# personal `.env.local` — primarily the GitHub Actions release-clients.yml
# workflow building the packaged Desktop installer, and any web-mode
# production build.
#
# These values intentionally mirror the main-process bake-in in
# src/Aonik.AdminDesktop/electron.vite.config.ts and are the SAME public
# Auth0 application identifiers every authenticated browser session sends
# to Auth0 today. They are not secrets. The real secrets (Auth0 client
# secret, management API secret) live only on the API and never reach the
# renderer.
#
# To point a build at a different Auth0 tenant, set the matching VITE_*
# vars in the workflow environment OR commit a separate `.env.<mode>`
# file and invoke `vite build --mode <mode>`. Override locally with
# `.env.local`, which Vite gives the highest precedence.

# Auth provider — desktop always uses Auth0 (system-browser PKCE).
VITE_AUTH_PROVIDER=auth0

# Auth0 application (public OIDC client). Matches the dev/staging tenant.
VITE_AUTH0_DOMAIN=aonik.uk.auth0.com
VITE_AUTH0_CLIENT_ID=ZoiNbhyAsfjKiNHYPudqsZ75zI1vFyYb
VITE_AUTH0_AUDIENCE=https://api.aonik.com
