# Aonik AdminUI Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# Auth Provider Selection
# =============================================================================
# Options: 'azure-ad' or 'auth0'
VITE_AUTH_PROVIDER=azure-ad

# =============================================================================
# Azure AD (Microsoft Entra ID) Configuration
# =============================================================================
# Get these from Azure Portal > App Registrations > Your App
VITE_AZURE_AD_CLIENT_ID=your-client-id-here
VITE_AZURE_AD_TENANT_ID=your-tenant-id-here
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173
VITE_AZURE_AD_API_SCOPE=api://aonik/.default

# =============================================================================
# Auth0 Configuration
# =============================================================================
# Get these from Auth0 Dashboard > Applications > Your App
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id-here
VITE_AUTH0_REDIRECT_URI=http://localhost:5173
VITE_AUTH0_AUDIENCE=https://api.aonik.com

# =============================================================================
# API Configuration
# =============================================================================
VITE_API_BASE_URL=https://localhost:5001
