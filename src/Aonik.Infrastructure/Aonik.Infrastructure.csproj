<Project Sdk="Microsoft.NET.Sdk">

  <!-- Boundary enforcement: allow test projects to access internals -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Aonik.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.Application\Aonik.Application.csproj" />
    <ProjectReference Include="..\Aonik.Platform\Aonik.Platform.csproj" />
    <ProjectReference Include="..\Aonik.Finance\Aonik.Finance.csproj" />
    <!-- Spec 041 / ADR-011: AonikDbContext owns the Order DbSets + applies the Order EF
         configs that now live in Aonik.Ordering (canonical migration stream). -->
    <ProjectReference Include="..\Aonik.Ordering\Aonik.Ordering.csproj" />
    <!-- Spec 042: AonikDbContext owns the Commerce DbSets + applies the Commerce EF configs
         (canonical migration stream). -->
    <ProjectReference Include="..\Aonik.Commerce\Aonik.Commerce.csproj" />
    <!-- Spec 087: AonikDbContext owns the Subscriptions DbSets + applies the Subscriptions EF
         configs (canonical migration stream). -->
    <ProjectReference Include="..\Aonik.Subscriptions\Aonik.Subscriptions.csproj" />
    <!-- Spec 086: AonikDbContext keeps owning the Groups DbSets + applies their EF configs, which
         now live in the Aonik.Groups middle layer. -->
    <ProjectReference Include="..\Aonik.Groups\Aonik.Groups.csproj" />
    <!--
      Permanent (Spec 027 R8): PersonalFinance entity types now live in
      Aonik.PersonalFinance but AonikDbContext (this project) keeps owning
      their DbSets so the canonical migration stream stays intact.
    -->
    <ProjectReference Include="..\Aonik.PersonalFinance\Aonik.PersonalFinance.csproj" />
    <ProjectReference Include="..\Aonik.Ai\Aonik.Ai.csproj" />
    <ProjectReference Include="..\Aonik.Agents\Aonik.Agents.csproj" />
    <!--
      Voice entities (spec 024 — speech provider library) live in Aonik.Voice but their EF
      migrations land in this project's canonical AonikDbContext per AONIK convention.
    -->
    <ProjectReference Include="..\Aonik.Voice\Aonik.Voice.csproj" />
    <!--
      Spec 035 — Documents entity types live in Aonik.Documents but AonikDbContext
      (this project) keeps owning their DbSets so the canonical migration stream
      stays intact. Mirrors the PersonalFinance arrangement above.
    -->
    <ProjectReference Include="..\Aonik.Documents\Aonik.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.47.1" />
    <PackageReference Include="Azure.Communication.Email" Version="1.0.0" />
    <PackageReference Include="Azure.Communication.Sms" Version="1.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.14.2" />
    <PackageReference Include="FluentStorage" Version="6.0.2" />
    <PackageReference Include="FluentStorage.Azure.Blobs" Version="6.0.2" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.1" />
    <!--
      Security pins (NU1904/NU1903): the EF-store package above pulls vulnerable
      DataProtection and Cryptography.Xml transitively. Pin patched versions directly
      so the audit clears for every project that references Infrastructure:
        - DataProtection 10.0.7 -> CVE-2026-40372 / GHSA-9mv3-2cwr-p262 (critical EoP)
        - Cryptography.Xml 10.0.7 -> CVE-2026-33116 / GHSA-37gx-xxp4-5rgx and
          CVE-2026-26171 / GHSA-w3x6-4m5h-cxqf (DoS); 10.0.7 (above the 10.0.6 fix
          floor) because DataProtection 10.0.7 requires Cryptography.Xml >= 10.0.7.
      Pinned at 10.0.7, not latest 10.0.8: 10.0.8 raises transitive Microsoft.Extensions
      floors above the project's pins and trips NU1605. The EF-store stays at 10.0.1 so
      the EF Core graph is untouched. (Hosting.Abstractions below is bumped to 10.0.7,
      the one project pin DataProtection 10.0.7 forces up.)
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.FeatureManagement" Version="4.0.0" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.1.0" />
    <!-- 10.0.8: required floor of Microsoft.Extensions.AI 10.6.0's transitive abstractions graph. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Mjml.Net" Version="4.11.0" />
    <PackageReference Include="Polly" Version="8.4.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Fluid.Core" Version="2.30.0" />
    <PackageReference Include="Quartz" Version="3.14.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.14.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


</Project>
