<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aonik.Agents</RootNamespace>
    <!--
      Spec 033 builds on MAF's Agent Skills API (AgentSkillsProvider / AgentSkillsProviderBuilder /
      AgentSkillFrontmatter), which ships in the pinned Microsoft.Agents.AI 1.5.0 marked
      [Experimental("MAAI001")]. The spec mandates building on these framework-native primitives, so
      we opt in to the evaluation diagnostic here.
    -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <!--
    Boundary enforcement: only Api, Infrastructure, and test projects may
    access internals. Platform / Finance entries were dropped after the
    Domain → Agents back-pointing was resolved — those modules now only
    reach Agents through SharedKernel.Abstractions.Agents contracts.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aonik.Api" />
    <InternalsVisibleTo Include="Aonik.Infrastructure" />
    <InternalsVisibleTo Include="Aonik.Agents.Tests" />
    <InternalsVisibleTo Include="Aonik.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Aonik.Application.Tests" />
    <InternalsVisibleTo Include="Aonik.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageReference Include="FastEndpoints" Version="7.1.1" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.5.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.5.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.1" />
    <PackageReference Include="ModelContextProtocol" Version="0.9.0-preview.2" />
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.3.0" />
  </ItemGroup>

</Project>
