<Project>
  <!--
    The C#-only properties + analyzers below are gated on the project
    extension. Aonik.AdminUi.esproj (a JavaScript/TypeScript front-end
    project that lives in the same .sln so dotnet build picks it up
    alongside its consumers) does NOT understand `net10.0` or
    Roslyn-analyzer PackageReferences, and CI fails NuGet restore on
    them ("Invalid target framework 'net10.0'") if they're applied
    unconditionally.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Warnings are errors by default (M6 / #119) so nullable, analyzer, and
      banned-API findings can't accumulate silently. A handful of modules with
      a pre-existing backlog opt out per-project (grep TreatWarningsAsErrors in
      their .csproj) and are ratcheted back in as the backlog is cleared.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NuGet restore/audit warnings are about dependencies, not code quality, so
      they stay warnings (visible for remediation) rather than build-breaking
      errors: NU1901-NU1904 = transitive-package CVE audit (low→critical; only
      fixable by an upstream bump — e.g. MessagePack via Aspire); NU1510 =
      redundant package reference.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;NU1510</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
