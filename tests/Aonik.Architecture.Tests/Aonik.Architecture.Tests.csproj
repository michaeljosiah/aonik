<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Architecture tests inspect every module assembly's compiled metadata, so
    every module project is referenced. The references make the assemblies
    available for NetArchTest's reflection scan; they do not relax any of
    the dependency rules expressed in tests, which assert against type
    namespaces and dependency edges rather than project references.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Aonik.SharedKernel\Aonik.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Platform\Aonik.Platform.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Finance\Aonik.Finance.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Ordering\Aonik.Ordering.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Commerce\Aonik.Commerce.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Ai\Aonik.Ai.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Agents\Aonik.Agents.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Application\Aonik.Application.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Infrastructure\Aonik.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Workspaces\Aonik.Workspaces.csproj" />
  </ItemGroup>

</Project>
