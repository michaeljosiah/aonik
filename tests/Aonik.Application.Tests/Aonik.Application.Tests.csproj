<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TODO(#119): ratchet opt-out — 2 pre-existing warnings (banned
         IgnoreQueryFilters — tests deliberately set up cross-tenant scenarios).
         Justify/suppress them, then delete this line so the
         TreatWarningsAsErrors=true default (Directory.Build.props) applies. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aonik.Agents\Aonik.Agents.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Application\Aonik.Application.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Cli\Aonik.Cli.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Finance\Aonik.Finance.csproj" />
    <!-- Direct reference (Spec 027 S5): the Finance -> PersonalFinance edge was
         dropped, so PersonalFinance types no longer resolve transitively. -->
    <ProjectReference Include="..\..\src\Aonik.PersonalFinance\Aonik.PersonalFinance.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Ordering\Aonik.Ordering.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Commerce\Aonik.Commerce.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Infrastructure\Aonik.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Platform\Aonik.Platform.csproj" />
    <ProjectReference Include="..\..\src\Aonik.Worker\Aonik.Worker.csproj" />
    <ProjectReference Include="..\Aonik.TestSupport\Aonik.TestSupport.csproj" />
  </ItemGroup>

</Project>
