<!doctype html>
<html lang="en">
<head>
	<title>MyBillAfrica</title>
	<meta charset="utf-8">
	<meta http-equiv="x-ua-compatible" content="ie=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<link rel="shortcut icon" href="images/favicon.ico">
	<link rel="stylesheet" href="css/bootstrap.min.css">
	<link rel="stylesheet" href="css/slick.css">
	<link rel="stylesheet" href="css/style.css">
</head>
<body>
	<div class="wrapper d-flex flex-column">
		<div class="container mb-auto">
			<div class="slider js-carousel text-center py-4">
				<div class="item js-slide">
					<img class="d-block mx-auto mb-4" src="images/slider-img-01.jpg" alt="">
					<h1>PAY YOUR BILLS <strong class="text-primary d-block">IN ONE PLACE</strong></h1>
				</div>
				<div class="item js-slide">
					<img class="d-block mx-auto mb-4" src="images/slider-img-01.jpg" alt="">
					<h1>SUPPORT YOUR <strong class="text-primary d-block">LOVED ONES</strong></h1>
				</div>
				<div class="item js-slide">
					<img class="d-block mx-auto mb-4" src="images/slider-img-01.jpg" alt="">
					<h1>KEEP TRACK OF <strong class="text-primary d-block">YOUR SPENDING</strong></h1>
				</div>
			</div>
		</div>
		<div class="container">
			<div class="row mt-5">
				<div class="col">
					<a class="btn btn-primary w-100 mb-4" href="login.html">LOGIN</a>
				</div>
				<div class="col">
					<a class="btn btn-secondary w-100 mb-4" href="register.html">REGISTER</a>
				</div>
			</div>
		</div>
	</div>
	
	<!-- jQuery and Bootstrap Bundle (includes Popper) -->
	<script src="js/jquery-3.5.1.min.js"></script>
	<script src="js/bootstrap.bundle.min.js"></script>
	<script src="js/jquery.validate.min.js"></script>
	<script src="js/slick.min.js"></script>
	<script src="js/script.js"></script>
</body>
</html>