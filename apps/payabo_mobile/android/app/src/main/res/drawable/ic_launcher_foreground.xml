<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: Payabo "P" + brand-orange dot. Content is
     sized to fit inside the ~66dp safe zone centered in the 108dp canvas
     (launcher masks vary: circle, squircle, rounded-square — all preserve
     the center 66dp). -->
